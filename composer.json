{
    "name": "fissible/attest",
    "description": "Tamper-evident signed evidence chains for application events, with optional public anchoring via OpenTimestamps.",
    "type": "library",
    "license": "MIT",
    "keywords": ["audit", "audit-log", "tamper-evident", "evidence", "ed25519", "opentimestamps", "merkle"],
    "authors": [
        {"name": "Allen McCabe", "email": "allenmccabe@gmail.com"}
    ],
    "require": {
        "php": "^8.2",
        "ext-sodium": "*",
        "ext-zip": "*",
        "ext-json": "*",
        "paragonie/constant_time_encoding": "^2.6 || ^3.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "symfony/uid": "^6.4 || ^7.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.7",
        "guzzlehttp/psr7": "^2.6",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {"Fissible\\Attest\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Fissible\\Attest\\Tests\\": "tests/"}
    },
    "config": {
        "sort-packages": true
    },
    "suggest": {
        "guzzlehttp/guzzle": "PSR-18 HTTP client suitable for OpenTimestampsCalendarClient."
    },
    "minimum-stability": "stable"
}
